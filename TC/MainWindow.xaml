 <!--
	#4E4348, #8DBBB4, #F2E9C6, #F3B569, #E86E67 - цвета вкладок
	
	эти цвета с дополнительными
	#4E4348, #D1C7CC, #CBD5C0. 
	#8DBBB4, #3B5753, #56413C. 
	#F2E9C6, #8F8563, #3F4E5A. 
	#F3B569, #7A5123, #4B5A65. 
	#E86E67, #6E2B27, #3D5452.
	
	самый-самый основной фон
	#F0EDE6
	
-->	
	
	<Window x:Class="TC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TC"
        mc:Ignorable="d"
        Title="Калькулятор времени" Height="500" Width="600"
        Background="#F3F3F3" FontFamily="Segoe UI">
	<Grid>
		<Grid.RowDefinitions>
			<!-- Верхняя строка для заголовков вкладок и гамбургера, нижняя — для содержимого -->
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель навигации -->
		<Grid Grid.Row="0" Background="#E3DDD3" KeyboardNavigation.TabNavigation="None">
			<Grid.ColumnDefinitions>
				<!-- Левая колонка строго под кнопку ☰ -->
				<ColumnDefinition Width="45"/>
				<!-- Правая колонка под горизонтальные закладки -->
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- 1. Кнопка-Гамбургер (слева сверху) -->
			<Button Grid.Column="0" x:Name="HamburgerButton" Content="☰" FontSize="20" Width="45" Height="45" Background="Transparent" BorderThickness="0" Click="MenuButton_Click" IsTabStop="False"/>

			<!-- 2. Выпадающее дублирующее меню -->
			<Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=HamburgerButton}" Placement="Bottom" StaysOpen="True">
				<Border Background="#F3EFE9" BorderBrush="Gray" BorderThickness="1" Width="160">
					<ListBox x:Name="MenuListBox" Background="Transparent" BorderThickness="0" SelectionChanged="MenuListBox_SelectionChanged" IsTabStop="False">
						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="Height" Value="40"/>
								<Setter Property="IsTabStop" Value="False"/>
								<Setter Property="FontWeight" Value="SemiBold"/>
								<!-- Полное переопределение шаблона, чтобы системные цвета Windows не перебивали наши -->
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="ListBoxItem">
											<Border Background="{TemplateBinding Background}" Padding="10,0" Margin="2,2,2,0">
												<ContentPresenter VerticalAlignment="Center"/>
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<!-- Вместо изменения цвета делаем кнопку чуть прозрачнее при наведении -->
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Opacity" Value="0.8"/>
									</Trigger>
								</Style.Triggers>
							</Style>
						</ListBox.ItemContainerStyle>

						<!-- Пункты меню (всегда своего цвета) -->
						<ListBoxItem Content="📅 Разность дат" Background="#4E464B" Foreground="#FFFFFF"/>
						<ListBoxItem Content="⏳ Вкладка 2" Background="#91BCB6" Foreground="#2E4A46"/>
						<ListBoxItem Content="🔄 Конвертер" Background="#F9EFC7" Foreground="#5B4F23"/>
						<ListBoxItem Content="📁 Интервалы" Background="#F5B66C" Foreground="#5C360C"/>
						<ListBoxItem Content="📁 Деление" Background="#EE6E65" Foreground="#FFFFFF" Margin="2,2,2,2"/>
					</ListBox>
				</Border>
			</Popup>
		
			<!-- 3. горизонтальные закладки (сверху) -->
			<ListBox Grid.Column="1" x:Name="TopTabHeaders" Background="Transparent" BorderThickness="0" 
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         SelectedIndex="{Binding SelectedIndex, ElementName=MainTabControl, Mode=TwoWay}"
         IsTabStop="False" KeyboardNavigation.TabNavigation="None">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Rows="1" VerticalAlignment="Stretch"/>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>

				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="FontSize" Value="13"/>
						<Setter Property="IsTabStop" Value="False"/>
						<Setter Property="FontWeight" Value="Bold"/>
						<!-- Переопределяем шаблон, чтобы сделать зазоры больше и скругление заметнее -->
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListBoxItem">
									<Border x:Name="ItemBorder" 
                                Background="{TemplateBinding Background}" 
                                Padding="5,12"
                                Margin="0,0,12,0" 
                                CornerRadius="0,12,0,0">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<ControlTemplate.Triggers>
										<!-- Подчеркивание активной вкладки -->
										<Trigger Property="IsSelected" Value="True">
											<Setter TargetName="ItemBorder" Property="BorderBrush" Value="#333333"/>
											<Setter TargetName="ItemBorder" Property="BorderThickness" Value="0,0,0,3"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<!-- Эффект наведения мыши -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Opacity" Value="0.8"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</ListBox.ItemContainerStyle>

				<!-- вкладки -->
				<ListBoxItem Content="Разность дат" Background="#4E464B" Foreground="#FFFFFF"/>
				<ListBoxItem Content="Вкладка 2" Background="#91BCB6" Foreground="#2E4A46"/>
				<ListBoxItem Content="Конвертер" Background="#F9EFC7" Foreground="#5B4F23"/>
				<ListBoxItem Content="Интервалы" Background="#F5B66C" Foreground="#5C360C"/>
				<ListBoxItem Content="Деление" Background="#EE6E65" Foreground="#4B1D1A"/>
			</ListBox>


		</Grid>

		<!-- Основной контент под меню -->
		<Grid Grid.Row="1" Margin="15">
			<TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="0,-4,0,4">
				<TabControl.Resources>
					<Style TargetType="TabItem">
						<Setter Property="Visibility" Value="Collapsed"/>
					</Style>
				</TabControl.Resources>

				<!-- Вкладка 1: Разница дат и времени -->
				<TabItem Background="#F3EFE9">
					<Grid Background="#F3EFE9">
						<Border Background="#4E464B" CornerRadius="8" Padding="15" Margin="1">
							<Grid KeyboardNavigation.TabNavigation="Cycle">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="0.45*"/>
									<ColumnDefinition Width="0.1*"/>
									<ColumnDefinition Width="0.45*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<!-- Заголовок вкладки -->
								<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                           Text="Вычисление разницы между датами и временем" 
                           FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#D1C7CC"/>

								<!-- ЛЕВАЯ КОЛОНКА (ДАТЫ) -->
								<!-- Дата 1 -->
								<DatePicker Grid.Row="1" Grid.Column="0" x:Name="StartDatePicker" 
                            Margin="0,0,0,15" SelectedDateChanged="CalculateDateDifference" 
                            HorizontalAlignment="Stretch" FontSize="20" Loaded="StartDatePicker_Loaded" 
                            TabIndex="1" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B"/>

								<!-- Дата 2 -->
								<DatePicker Grid.Row="2" Grid.Column="0" x:Name="EndDatePicker" 
                            Margin="0,0,0,15" SelectedDateChanged="CalculateDateDifference" 
                            HorizontalAlignment="Stretch" FontSize="20" Loaded="StartDatePicker_Loaded" 
                            TabIndex="3" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B"/>

								<!-- Блок вывода результата дат -->
								<Border Grid.Row="3" Grid.Column="0" x:Name="ResultBorder" 
                        Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" 
                        Height="80" Margin="0,20,0,0" HorizontalAlignment="Stretch">
									<TextBlock x:Name="DateResultText" Text="" FontSize="20" Foreground="#D1C7CC" 
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" 
                               Margin="10,0" FontWeight="SemiBold"/>
								</Border>


								<!-- ПРАВАЯ КОЛОНКА (ВРЕМЯ) -->
								<!-- Время 1 -->
								<TextBox Grid.Row="1" Grid.Column="2" x:Name="StartTimeTextBox" 
                         Margin="0,0,0,15" TextChanged="TimeTextBox_TextChanged" 
                         HorizontalAlignment="Stretch" VerticalContentAlignment="Center" FontSize="20" 
                         TabIndex="2" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B" 
                         Padding="5,2"/>

								<!-- Время 2 -->
								<TextBox Grid.Row="2" Grid.Column="2" x:Name="EndTimeTextBox" 
                         Margin="0,0,0,15" TextChanged="TimeTextBox_TextChanged" 
                         HorizontalAlignment="Stretch" VerticalContentAlignment="Center" FontSize="20" 
                         TabIndex="4" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B" 
                         Padding="5,2"/>

								<!-- Блок вывода результата времени -->
								<Border Grid.Row="3" Grid.Column="2" x:Name="TimeResultBorder" 
                        Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" 
                        Height="80" Margin="0,20,0,0" HorizontalAlignment="Stretch">
									<TextBlock x:Name="TimeResultText" Text="" FontSize="20" Foreground="#D1C7CC" 
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" 
                               Margin="10,0" FontWeight="SemiBold"/>
								</Border>


								<!-- НИЖНИЙ БЛОК (ОБЩИЙ РЕЗУЛЬТАТ) -->
								<!-- Общая разность на всю ширину под результатами -->
								<Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="TotalResultBorder" 
                        Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" 
                        Height="60" Margin="0,20,0,0" HorizontalAlignment="Stretch">
									<TextBlock x:Name="TotalResultText" Text="" FontSize="20" Foreground="#D1C7CC" 
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" 
                               Margin="10,0" FontWeight="SemiBold"/>
								</Border>

							</Grid>
						</Border>
					</Grid>
				</TabItem>


				<!-- Вкладка 2: Пустая (Набор 2) -->
				<TabItem>
					<Grid Background="#F3EFE9">

						<Border Background="#91BCB6" CornerRadius="8" Padding="15" Margin="1">
							<Grid>

								<TextBlock Text="Вкладка 2 (Пусто)" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="16" 
                           Foreground="#2E4A46" 
                           FontWeight="SemiBold"/>
							</Grid>
						</Border>
					</Grid>
				</TabItem>

				<!-- Вкладка 3: Конвертер (Набор 3) -->
<TabItem>
	<Grid Background="#F3EFE9">
		<!-- Пастельно-жёлтая карточка с тонким зазором по периметру -->
		<Border Background="#F9EFC7" CornerRadius="8" Padding="15" Margin="5">
			<!-- прокрутка, при необходимости -->
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<!-- Заголовок перекрашен в Текст Набора 3 -->
					<TextBlock Grid.Row="0" Text="Конвертер единиц времени" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#5B4F23"/>

					<!-- Сетка: 30% | 10% | 60% -->
					<Grid Grid.Row="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="0.30*"/>
							<ColumnDefinition Width="0.10*"/>
							<ColumnDefinition Width="0.60*"/>
						</Grid.ColumnDefinitions>

						<!-- ================= ЛЕВАЯ ЧАСТЬ (30%) ================= -->
						<StackPanel Grid.Column="0">
								<ComboBox x:Name="FromUnit" SelectedIndex="0" Margin="0,0,0,15" Padding="5" FontSize="20" SelectionChanged="ConvertTime" Background="#F3EFE9" BorderBrush="#CBBF92" >
								<ComboBoxItem Content="Секунды"/>
								<ComboBoxItem Content="Минуты"/>
								<ComboBoxItem Content="Часы"/>
								<ComboBoxItem Content="Недели"/>
								<ComboBoxItem Content="Месяцы"/>
								<ComboBoxItem Content="Годы"/>
							</ComboBox>

											<TextBox x:Name="InputValue" Padding="8" FontSize="20" TextWrapping="NoWrap" 
													 AcceptsReturn="False" TextChanged="ConvertTime" Background="#F3EFE9" 
													 BorderBrush="#CBBF92" Foreground="#5B4F23" 
													 PreviewTextInput="InputValue_PreviewTextInput"/>
						</StackPanel>

						<!-- ================= СЕРЕДИНА (10%) ================= -->
						<Grid Grid.Column="1"/>

						<!-- ================= ПРАВАЯ ЧАСТЬ (60%) ================= -->
						<StackPanel Grid.Column="2">
							<Grid Grid.IsSharedSizeScope="True">
								<!-- 1. СТИЛИЗОВАННАЯ КНОПКА ПОД НАБОР 3 -->
								<Grid.Resources>
									<Style x:Key="CopyButtonStyle" TargetType="Button">
										<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
										<Setter Property="Content" Value="&#xE8C8;"/>
										<Setter Property="FontSize" Value="11"/>
										<Setter Property="Width" Value="24"/>
										<Setter Property="Height" Value="24"/>
										<Setter Property="VerticalAlignment" Value="Top"/>
										<Setter Property="HorizontalAlignment" Value="Right"/>
										<Setter Property="Margin" Value="5,2,0,0"/>
										<!-- Настройка цветов кнопки под палитру желтого набора -->
										<Setter Property="Background" Value="#F3E5A9"/>
										<Setter Property="BorderBrush" Value="#CBBF92"/>
										<Setter Property="BorderThickness" Value="1"/>
										<Setter Property="Foreground" Value="#5B4F23"/>
										<Setter Property="Cursor" Value="Hand"/>
										<Setter Property="ToolTip" Value="Копировать"/>
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="#E9D994"/>
												<Setter Property="BorderBrush" Value="#A89C6F"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</Grid.Resources>

								<!-- 2. ОПРЕДЕЛЕНИЕ КОЛОНОК И СТРОК -->
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="35"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
								</Grid.RowDefinitions>

								<!-- 3. СОДЕРЖИМОЕ ТАБЛИЦЫ (Цвета текстов переведены на #5B4F23) -->
								<!-- Секунды -->
								<TextBlock Grid.Row="0" Grid.Column="0" Text="Секунды:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="0" Grid.Column="1" x:Name="ResultSeconds" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultSeconds}"/>

								<!-- Минуты -->
								<TextBlock Grid.Row="1" Grid.Column="0" Text="Минуты:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResultMinutes" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultMinutes}"/>

								<!-- Часы -->
								<TextBlock Grid.Row="2" Grid.Column="0" Text="Часы:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="2" Grid.Column="1" x:Name="ResultHours" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultHours}"/>

								<!-- Недели -->
								<TextBlock Grid.Row="3" Grid.Column="0" Text="Недели:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="3" Grid.Column="1" x:Name="ResultWeeks" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultWeeks}"/>

								<!-- Месяцы -->
								<TextBlock Grid.Row="4" Grid.Column="0" Text="Месяцы:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="4" Grid.Column="1" x:Name="ResultMonths" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="4" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultMonths}"/>

								<!-- Годы -->
								<TextBlock Grid.Row="5" Grid.Column="0" Text="Годы:" FontSize="14" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="5" Grid.Column="1" x:Name="ResultYears" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="5" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultYears}"/>
							</Grid>

							<!-- Разделитель в цвет Акцента Набора 3 -->
							<Separator Margin="0,15,0,15" Background="#CBBF92"/>
							
							<!-- Итоговая строка в цвете Набора 3 -->
							<TextBlock x:Name="FullFormattedResult" Text="0 Лет 0 Месяцев 0 Дней 0 Часов 0 Минут 0 Секунд" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#5B4F23"/>
						</StackPanel>
					</Grid>
				</Grid>
			</ScrollViewer>
		</Border>
	</Grid>
</TabItem>

				<!-- Вкладка 4: Сумма/разность интервалов (Набор 4) -->
				<TabItem>
					<Grid Background="#F3EFE9">
						<!-- Приглушённо-оранжевая карточка -->
						<Border Background="#F5B66C" CornerRadius="8" Padding="15" Margin="5">
							<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
								<Grid KeyboardNavigation.TabNavigation="Cycle">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="*" />
									</Grid.RowDefinitions>

									<!-- Описание стилей кнопок под Набор 4 с инверсией цвета -->
									<Grid.Resources>
										<Style x:Key="IntervalButtonStyle" TargetType="Button">
											<Setter Property="FontSize" Value="14"/>
											<Setter Property="Cursor" Value="Hand"/>
											<Setter Property="IsTabStop" Value="False"/>
											<!-- Полностью убираем системный голубой стиль при наведении через ControlTemplate -->
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="Button">
														<Border x:Name="ButtonBorder" 
												Background="#5C360C" 
												BorderBrush="#5C360C" 
												BorderThickness="1" 
												Padding="12,5" 
												CornerRadius="2">
															<ContentPresenter x:Name="ButtonContent" 
															  HorizontalAlignment="Center" 
															  VerticalAlignment="Center" 
															  TextBlock.Foreground="#F5B66C"/>
														</Border>
														<ControlTemplate.Triggers>
															<!-- Эффект при наведении: меняем цвет фона и текста местами -->
															<Trigger Property="IsMouseOver" Value="True">
																<Setter TargetName="ButtonBorder" Property="Background" Value="#F5B66C"/>
																<Setter TargetName="ButtonContent" Property="TextBlock.Foreground" Value="#5C360C"/>
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>

										<Style x:Key="MathButtonStyle" TargetType="Button" BasedOn="{StaticResource IntervalButtonStyle}">
											<Setter Property="IsTabStop" Value="True"/>
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="Button">
														<Border x:Name="ButtonBorder" 
												Background="#5C360C" 
												BorderBrush="#5C360C" 
												BorderThickness="1" 
												Width="60" 
												Height="45" 
												CornerRadius="2">
															<ContentPresenter x:Name="ButtonContent" 
															  HorizontalAlignment="Center" 
															  VerticalAlignment="Center" 
															  TextBlock.Foreground="#F5B66C" 
															  TextBlock.FontSize="24" 
															  TextBlock.FontWeight="SemiBold"/>
														</Border>
														<ControlTemplate.Triggers>
															<!-- Инверсия для математических кнопок -->
															<Trigger Property="IsMouseOver" Value="True">
																<Setter TargetName="ButtonBorder" Property="Background" Value="#F5B66C"/>
																<Setter TargetName="ButtonContent" Property="TextBlock.Foreground" Value="#5C360C"/>
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>

										<!-- Иконка копирования (оставляем аккуратной песочной) -->
										<Style x:Key="IconButtonStyle" TargetType="Button">
											<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
											<Setter Property="Content" Value="&#xE8C8;"/>
											<Setter Property="FontSize" Value="11"/>
											<Setter Property="Width" Value="32"/>
											<Setter Property="Height" Value="28"/>
											<Setter Property="Padding" Value="0"/>
											<Setter Property="IsTabStop" Value="False"/>
											<Setter Property="Cursor" Value="Hand"/>
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="Button">
														<Border x:Name="ButtonBorder" Background="#EAB069" BorderBrush="#C28B47" BorderThickness="1" CornerRadius="2">
															<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#5C360C"/>
														</Border>
														<ControlTemplate.Triggers>
															<Trigger Property="IsMouseOver" Value="True">
																<Setter TargetName="ButtonBorder" Property="Background" Value="#C28B47"/>
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</Grid.Resources>

									<!-- Заголовок -->
									<TextBlock Grid.Row="0" Text="Сумма/разность интервалов" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#5C360C"/>

									<Grid Grid.Row="1">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="140"/>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>

										<!-- Результат -->
										<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,25" VerticalAlignment="Center">
											<TextBlock x:Name="IntervalResultText" Text="0 д 0 ч 0 мин 0 с" FontSize="20" FontWeight="SemiBold" Foreground="#5C360C" VerticalAlignment="Center" Margin="0,0,15,0"/>
											<Button Style="{StaticResource IconButtonStyle}" Click="CopyIntervalResult_Click" ToolTip="Copy"/>
										</StackPanel>
										<Button Grid.Row="0" Grid.Column="1" Content="Очистить" Style="{StaticResource IntervalButtonStyle}" Click="ClearResult_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,25"/>

										<!-- Ввод интервала -->
										<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,25">
											<TextBox x:Name="InputIntervalDays" FontSize="20" Padding="6" Width="60" TabIndex="1" VerticalAlignment="Center" Background="#F3EFE9" BorderBrush="#C28B47" Foreground="#5C360C" PreviewTextInput="InputValue_PreviewTextInput" PreviewKeyDown="InputValue_PreviewKeyDown"/>
											<TextBlock Text="д" FontSize="16" VerticalAlignment="Center" Margin="5,0,15,0" Foreground="#5C360C" FontWeight="SemiBold"/>

											<TextBox x:Name="InputIntervalHours" FontSize="20" Padding="6" Width="60" TabIndex="2" VerticalAlignment="Center" Background="#F3EFE9" BorderBrush="#C28B47" Foreground="#5C360C" PreviewTextInput="InputValue_PreviewTextInput" PreviewKeyDown="InputValue_PreviewKeyDown"/>
											<TextBlock Text="ч" FontSize="16" VerticalAlignment="Center" Margin="5,0,15,0" Foreground="#5C360C" FontWeight="SemiBold"/>

											<TextBox x:Name="InputIntervalMinutes" FontSize="20" Padding="6" Width="60" TabIndex="3" VerticalAlignment="Center" Background="#F3EFE9" BorderBrush="#C28B47" Foreground="#5C360C" PreviewTextInput="InputValue_PreviewTextInput" PreviewKeyDown="InputValue_PreviewKeyDown"/>
											<TextBlock Text="мин" FontSize="16" VerticalAlignment="Center" Margin="5,0,15,0" Foreground="#5C360C" FontWeight="SemiBold"/>

											<TextBox x:Name="InputIntervalSeconds" FontSize="20" Padding="6" Width="60" TabIndex="4" VerticalAlignment="Center" Background="#F3EFE9" BorderBrush="#C28B47" Foreground="#5C360C" PreviewTextInput="InputValue_PreviewTextInput" PreviewKeyDown="InputValue_PreviewKeyDown"/>
											<TextBlock Text="с" FontSize="16" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#5C360C" FontWeight="SemiBold"/>
										</StackPanel>
										<Button Grid.Row="1" Grid.Column="1" Content="Очистить" Style="{StaticResource IntervalButtonStyle}" Click="ClearInputFields_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,25"/>

										<!-- Кнопки + - -->
										<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
											<Button Content="+" Style="{StaticResource MathButtonStyle}" Click="AddInterval_Click" TabIndex="5" Margin="0,0,15,0"/>
											<Button Content="-" Style="{StaticResource MathButtonStyle}" Click="SubtractInterval_Click" TabIndex="6"/>
										</StackPanel>
									</Grid>
								</Grid>
							</ScrollViewer>
						</Border>
					</Grid>
				</TabItem>

				<!-- Вкладка 5: Пустая (Набор 5) -->
				<TabItem>
					<Grid Background="#F3EFE9">
						<!-- Кораллово-красная карточка с тонким зазором по периметру -->
						<Border Background="#EE6E65" CornerRadius="8" Padding="15" Margin="5">
							<Grid>
								<!-- Текст теперь тёмно-бордовый (#4B1D1A) из Набора 5 -->
								<TextBlock Text="Вкладка 5 (Пусто)" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="16" 
                           Foreground="#4B1D1A" 
                           FontWeight="SemiBold"/>
							</Grid>
						</Border>
					</Grid>
				</TabItem>


			</TabControl>
		</Grid>
	</Grid>
</Window>
