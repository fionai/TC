 <!--
	#4E4348, #8DBBB4, #F2E9C6, #F3B569, #E86E67 - цвета вкладок
	
	эти цвета с дополнительными
	#4E4348, #D1C7CC, #CBD5C0.
	#8DBBB4, #3B5753, #56413C.
	#F2E9C6, #8F8563, #3F4E5A. 
	#F3B569, #7A5123, #4B5A65. 
	#E86E67, #6E2B27, #3D5452.
	
	самый-самый основной фон
	#F0EDE6
	
-->	
	
	<Window x:Class="TC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TC"
        mc:Ignorable="d"
        Title="Калькулятор времени" Height="600" Width="600"
        Background="#F3F3F3" FontFamily="Segoe UI">
	<Grid Margin="0,4,0,-4">
		<Grid.RowDefinitions>
			<!-- Верхняя строка для заголовков вкладок и гамбургера, нижняя — для содержимого -->
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель навигации -->
		<Grid Grid.Row="0" Background="#E3DDD3" KeyboardNavigation.TabNavigation="None">
			<Grid.ColumnDefinitions>
				<!-- Левая колонка под кнопку ☰ -->
				<ColumnDefinition Width="45"/>
				<!-- Правая колонка под горизонтальные закладки -->
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- 1. Кнопка-Гамбургер -->
			<Button Grid.Column="0" x:Name="HamburgerButton" Content="☰" FontSize="20" Width="45" Height="45" Background="Transparent" BorderThickness="0" Click="MenuButton_Click" IsTabStop="False"/>

			<!-- 2. Выпадающее меню -->
			<Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=HamburgerButton}" Placement="Bottom" StaysOpen="True">
				<Border Background="#F3EFE9" BorderBrush="Gray" BorderThickness="1" Width="190">
					<ListBox x:Name="MenuListBox" Background="Transparent" BorderThickness="0" SelectionChanged="MenuListBox_SelectionChanged" IsTabStop="False">
						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="Height" Value="40"/>
								<Setter Property="IsTabStop" Value="False"/>
								<Setter Property="FontWeight" Value="SemiBold"/>
								<!-- Полное переопределение шаблона, чтобы системные цвета Windows не перебивали наши -->
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="ListBoxItem">
											<Border Background="{TemplateBinding Background}" Padding="10,0" Margin="2,2,2,0">
												<ContentPresenter VerticalAlignment="Center"/>
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<!-- Вместо изменения цвета делаем кнопку чуть прозрачнее при наведении -->
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Opacity" Value="0.8"/>
									</Trigger>
								</Style.Triggers>
							</Style>
						</ListBox.ItemContainerStyle>

						<!-- Пункты меню (всегда своего цвета) -->
						<ListBoxItem Content="📅 Разность дат и времени" Background="#4E464B" Foreground="#FFFFFF"/>
						<ListBoxItem Content="⏳ Добавить" Background="#91BCB6" Foreground="#2E4A46"/>
						<ListBoxItem Content="🔄 Конвертер" Background="#F9EFC7" Foreground="#5B4F23"/>
						<ListBoxItem Content="📁 Интервалы" Background="#F5B66C" Foreground="#5C360C"/>
						<ListBoxItem Content="📁 Деление" Background="#EE6E65" Foreground="#FFFFFF" Margin="2,2,2,2"/>
					</ListBox>
				</Border>
			</Popup>
		
			<!-- 3. горизонтальные закладки (сверху) -->
			<ListBox Grid.Column="1" x:Name="TopTabHeaders" Background="Transparent" BorderThickness="0" 
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         SelectedIndex="{Binding SelectedIndex, ElementName=MainTabControl, Mode=TwoWay}"
         IsTabStop="False" KeyboardNavigation.TabNavigation="None">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Rows="1" VerticalAlignment="Stretch"/>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>

				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="FontSize" Value="13"/>
						<Setter Property="IsTabStop" Value="False"/>
						<Setter Property="FontWeight" Value="Bold"/>
						<!-- Переопределяем шаблон, чтобы сделать зазоры больше и скругление заметнее -->
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListBoxItem">
									<Border x:Name="ItemBorder" 
                                Background="{TemplateBinding Background}" 
                                Padding="5,12"
                                Margin="0,0,12,0" 
                                CornerRadius="0,12,0,0">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<ControlTemplate.Triggers>
										<!-- Подчеркивание активной вкладки -->
										<Trigger Property="IsSelected" Value="True">
											<Setter TargetName="ItemBorder" Property="BorderBrush" Value="#333333"/>
											<Setter TargetName="ItemBorder" Property="BorderThickness" Value="0,0,0,3"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<!-- Эффект наведения мыши -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Opacity" Value="0.8"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</ListBox.ItemContainerStyle>

				<!-- вкладки -->
				<ListBoxItem Content="Разность" Background="#4E464B" Foreground="#FFFFFF"/>
				<ListBoxItem Content="Добавить" Background="#91BCB6" Foreground="#2E4A46"/>
				<ListBoxItem Content="Конвертер" Background="#F9EFC7" Foreground="#5B4F23"/>
				<ListBoxItem Content="Интервалы" Background="#F5B66C" Foreground="#5C360C"/>
				<ListBoxItem Content="Деление" Background="#EE6E65" Foreground="#4B1D1A"/>
			</ListBox>


		</Grid>

		<!-- Основной контент под меню -->
		<Grid Grid.Row="1" Margin="15">
			<TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="0,-4,0,4">
				<TabControl.Resources>
					<Style TargetType="TabItem">
						<Setter Property="Visibility" Value="Collapsed"/>
					</Style>
				</TabControl.Resources>

				<!-- Вкладка 1: Разница дат и времени -->
				<TabItem Background="#F3EFE9">
					<Grid Background="#F3EFE9">
						<Border Background="#4E464B" CornerRadius="8" Padding="15" Margin="1">
							<Grid KeyboardNavigation.TabNavigation="Cycle">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="0.45*"/>
									<ColumnDefinition Width="0.1*"/>
									<ColumnDefinition Width="0.45*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<!-- 1. СТИЛИЗОВАННАЯ КНОПКА  -->
								<Grid.Resources>
									<Style x:Key="CopyButtonStyle" TargetType="Button">
										<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
										<Setter Property="Content" Value="&#xE8C8;"/>
										<Setter Property="FontSize" Value="11"/>
										<Setter Property="Width" Value="24"/>
										<Setter Property="Height" Value="24"/>
										<Setter Property="VerticalAlignment" Value="Top"/>
										<Setter Property="HorizontalAlignment" Value="Right"/>
										<Setter Property="Margin" Value="5,2,0,0"/>
										<!-- Настройка цветов кнопки -->
										<Setter Property="Background" Value="#4E464B"/>
										<Setter Property="BorderBrush" Value="#4E464B"/>
										<Setter Property="BorderThickness" Value="1"/>
										<Setter Property="Foreground" Value="#D1C7CC"/>
										<Setter Property="Cursor" Value="Hand"/>
										<Setter Property="ToolTip" Value="Копировать"/>
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="#E9D994"/>
												<Setter Property="BorderBrush" Value="#A89C6F"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</Grid.Resources>

								<!-- Заголовок -->
								<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
									Text="Разность" 
									FontSize="20" FontWeight="SemiBold" 
									Margin="0,0,0,20" Foreground="#D1C7CC"/>

								<!-- Левая колонка (Даты) -->
								<!-- Дата 1 -->
								<DatePicker Grid.Row="1" Grid.Column="0" x:Name="StartDatePicker" 
                            Margin="0,0,0,15" SelectedDateChanged="CalculateDateDifference" 
                            HorizontalAlignment="Stretch" FontSize="20" Loaded="StartDatePicker_Loaded" 
                            TabIndex="1" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B"/>

								<!-- Дата 2 -->
								<DatePicker Grid.Row="2" Grid.Column="0" x:Name="EndDatePicker" 
                            Margin="0,0,0,15" SelectedDateChanged="CalculateDateDifference" 
                            HorizontalAlignment="Stretch" FontSize="20" Loaded="StartDatePicker_Loaded" 
                            TabIndex="3" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B"/>

								<!-- Блок вывода результата дат -->
								<Border Grid.Row="3" Grid.Column="0" x:Name="ResultBorder" 
                        Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" 
                        Height="80" Margin="0,20,0,0" HorizontalAlignment="Stretch">
									<TextBlock x:Name="DateResultText" Text="" FontSize="20" Foreground="#D1C7CC" 
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" 
                               Margin="10,0" FontWeight="SemiBold"/>
								</Border>


								<!-- Правая колонка (время) -->

								<!-- Время 1 -->
								<TextBox Grid.Row="1" Grid.Column="2" x:Name="StartTimeTextBox" 
										Margin="0,0,0,15" Text="Время" TextChanged="TimeTextBox_TextChanged" 
										HorizontalAlignment="Stretch" VerticalContentAlignment="Center" FontSize="20" 
										TabIndex="2" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B" 
										Padding="5,2"
										GotFocus="TimeTextBox_GotFocus" 
										LostFocus="TimeTextBox_LostFocus" 
										PreviewTextInput="TimeTextBox_PreviewTextInput" 
										PreviewKeyDown="TimeTextBox_PreviewKeyDown" 
										MouseDoubleClick="TimeTextBox_MouseDoubleClick"
										PreviewMouseLeftButtonDown="TimeTextBox_PreviewMouseLeftButtonDown"/>

								<!-- Время 2 -->
								<TextBox Grid.Row="2" Grid.Column="2" x:Name="EndTimeTextBox" 
										Margin="0,0,0,15" Text="Время" TextChanged="TimeTextBox_TextChanged" 
										HorizontalAlignment="Stretch" VerticalContentAlignment="Center" FontSize="20" 
										TabIndex="4" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B" 
										Padding="5,2"
										GotFocus="TimeTextBox_GotFocus" 
										LostFocus="TimeTextBox_LostFocus" 
										PreviewTextInput="TimeTextBox_PreviewTextInput" 
										PreviewKeyDown="TimeTextBox_PreviewKeyDown" 
										MouseDoubleClick="TimeTextBox_MouseDoubleClick"
										PreviewMouseLeftButtonDown="TimeTextBox_PreviewMouseLeftButtonDown"/>

								<!-- Вывод результата времени -->
								<Border Grid.Row="3" Grid.Column="2" x:Name="TimeResultBorder" 
                        Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" 
                        Height="80" Margin="0,20,0,0" HorizontalAlignment="Stretch">
									<TextBlock x:Name="TimeResultText" Text="" FontSize="20" Foreground="#D1C7CC" 
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" 
                               Margin="10,0" FontWeight="SemiBold"/>
								</Border>

								<!-- Общая разность на всю ширину под результатами -->
								<Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="TotalResultBorder" 
									Background="Transparent" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" 
									Height="60" Margin="0,20,0,0" HorizontalAlignment="Stretch">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
									<!--Результат-->
									<TextBlock x:Name="DifferenceResult" Grid.Column="0"
										Foreground="#D1C7CC" Text="" FontSize="20" FontWeight="SemiBold"
										TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" 
										Margin="10,0"/>
									<!--Кнопка копировать-->
										<Button Name="DifferenceCopy" Grid.Column="1" Style="{StaticResource CopyButtonStyle}"
											Width="32" Height="32" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
											Click="CopyFullResult_Click" />
									</Grid>
								</Border>

							</Grid>
						</Border>
					</Grid>
				</TabItem>


				<!-- Вкладка 2: Добавить -->
				<TabItem Background="#F3EFE9">
					<Grid Background="#F3EFE9">

						<Border Background="#91BCB6" CornerRadius="8" Padding="15" Margin="1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="0.45*"/>
									<ColumnDefinition Width="0.10*"/>
									<ColumnDefinition Width="0.45*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								
								<!-- Заголовок -->
								<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
										   Text="Добавить интервал"
										   FontSize="20" FontWeight="SemiBold" 
										   Margin="0,0,0,20"
										   Foreground="#3B5753"/>

								<!-- Дата -->
								<DatePicker Grid.Row="1" Grid.Column="0" x:Name="StartDate" 
									Margin="0,0,0,15" SelectedDateChanged="CalculateDateDifference" 
									HorizontalAlignment="Stretch" FontSize="20" Loaded="StartDatePicker_Loaded" 
									TabIndex="1" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B"/>
								<!-- Время -->
								<TextBox Grid.Row="1" Grid.Column="2" x:Name="StartTime" 
										Margin="0,0,0,15" Text="Время" TextChanged="TimeTextBox_TextChanged" 
										HorizontalAlignment="Stretch" VerticalContentAlignment="Center" FontSize="20" 
										TabIndex="2" Background="#F3EFE9" BorderBrush="#6A5F65" Foreground="#4E464B" 
										Padding="5,2"
										GotFocus="TimeTextBox_GotFocus" 
										LostFocus="TimeTextBox_LostFocus" 
										PreviewTextInput="TimeTextBox_PreviewTextInput" 
										PreviewKeyDown="TimeTextBox_PreviewKeyDown" 
										MouseDoubleClick="TimeTextBox_MouseDoubleClick"
										PreviewMouseLeftButtonDown="TimeTextBox_PreviewMouseLeftButtonDown"/>								
							</Grid>
						</Border>
					</Grid>
				</TabItem>

				<!-- Вкладка 3: Конвертер (Набор 3) -->
<TabItem>
	<Grid Background="#F3EFE9">

		<Border Background="#F9EFC7" CornerRadius="8" Padding="15" Margin="5">
			<!-- прокрутка -->
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<Grid>
								<!-- 1. СТИЛИЗОВАННАЯ КНОПКА  -->
								<Grid.Resources>
									<Style x:Key="CopyButtonStyle" TargetType="Button">
										<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
										<Setter Property="Content" Value="&#xE8C8;"/>
										<Setter Property="FontSize" Value="11"/>
										<Setter Property="Width" Value="24"/>
										<Setter Property="Height" Value="24"/>
										<Setter Property="VerticalAlignment" Value="Top"/>
										<Setter Property="HorizontalAlignment" Value="Right"/>
										<Setter Property="Margin" Value="5,2,0,0"/>
										<!-- Настройка цветов кнопки -->
										<Setter Property="Background" Value="#F3E5A9"/>
										<Setter Property="BorderBrush" Value="#CBBF92"/>
										<Setter Property="BorderThickness" Value="1"/>
										<Setter Property="Foreground" Value="#5B4F23"/>
										<Setter Property="Cursor" Value="Hand"/>
										<Setter Property="ToolTip" Value="Копировать"/>
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="#E9D994"/>
												<Setter Property="BorderBrush" Value="#A89C6F"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</Grid.Resources>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Text="Конвертер единиц времени" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#5B4F23"/>

					<!-- Сетка: 30% | 10% | 60% -->
					<Grid Grid.Row="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="0.30*"/>
							<ColumnDefinition Width="0.10*"/>
							<ColumnDefinition Width="0.60*"/>
						</Grid.ColumnDefinitions>

						<!-- ================= ЛЕВАЯ ЧАСТЬ (30%) ================= -->
						<StackPanel Grid.Column="0">
								<ComboBox x:Name="FromUnit" SelectedIndex="0" Margin="0,0,0,15" Padding="5" FontSize="20" SelectionChanged="ConvertTime" Background="#F3EFE9" BorderBrush="#CBBF92" >
								<ComboBoxItem Content="Секунды" />
								<ComboBoxItem Content="Минуты"/>
								<ComboBoxItem Content="Часы"/>
								<ComboBoxItem Content="Недели"/>
								<ComboBoxItem Content="Месяцы"/>
								<ComboBoxItem Content="Годы"/>
							</ComboBox>

											<TextBox x:Name="InputValue" Padding="8" FontSize="20" TextWrapping="NoWrap" 
													 AcceptsReturn="False" TextChanged="ConvertTime" Background="#F3EFE9" 
													 BorderBrush="#CBBF92" Foreground="#5B4F23" 
													 PreviewTextInput="InputValue_PreviewTextInput"/>
						</StackPanel>

						<!-- ================= СЕРЕДИНА (10%) ================= -->
						<Grid Grid.Column="1"/>

						<!-- ================= ПРАВАЯ ЧАСТЬ (60%) ================= -->
						<StackPanel Grid.Column="2">
							<Grid Grid.IsSharedSizeScope="True">

								<!-- 2. ОПРЕДЕЛЕНИЕ КОЛОНОК И СТРОК -->
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="35"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
									<RowDefinition Height="Auto" MinHeight="35"/>
								</Grid.RowDefinitions>

								<!-- 3. СОДЕРЖИМОЕ ТАБЛИЦЫ  -->
								<!-- Секунды -->
								<TextBlock Grid.Row="0" Grid.Column="0" Text="Секунды:" FontSize="20" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="0" Grid.Column="1" x:Name="ResultSeconds" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultSeconds}"/>

								<!-- Минуты -->
								<TextBlock Grid.Row="1" Grid.Column="0" Text="Минуты:" FontSize="20" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResultMinutes" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultMinutes}"/>

								<!-- Часы -->
								<TextBlock Grid.Row="2" Grid.Column="0" Text="Часы:" FontSize="20" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="2" Grid.Column="1" x:Name="ResultHours" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultHours}"/>

								<!-- Недели -->
								<TextBlock Grid.Row="3" Grid.Column="0" Text="Недели:" FontSize="20" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="3" Grid.Column="1" x:Name="ResultWeeks" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultWeeks}"/>

								<!-- Месяцы -->
								<TextBlock Grid.Row="4" Grid.Column="0" Text="Месяцы:" FontSize="20" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="4" Grid.Column="1" x:Name="ResultMonths" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="4" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultMonths}"/>

								<!-- Годы -->
								<TextBlock Grid.Row="5" Grid.Column="0" Text="Годы:" FontSize="20" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#5B4F23"/>
								<TextBlock Grid.Row="5" Grid.Column="1" x:Name="ResultYears" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#5B4F23" VerticalAlignment="Top" Margin="0,3,5,0" TextWrapping="Wrap"/>
								<Button Grid.Row="5" Grid.Column="2" Style="{StaticResource CopyButtonStyle}" Click="CopyResult_Click" Tag="{Binding ElementName=ResultYears}"/>
							</Grid>

											<!-- Разделитель -->
											<Separator Margin="0,15,0,15" Background="#CBBF92"/>

											<!-- бокс итогового результата с кнопкой копирования -->
											<Border Background="Transparent" BorderBrush="#CBBF92" BorderThickness="1" CornerRadius="2" 
									MinHeight="60" Padding="10,5" HorizontalAlignment="Stretch">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>

													<!-- строка результат -->
													<TextBlock x:Name="ConverterResult" Grid.Column="0" 
											   Text="0 дн 0 мес 0 Дней 0 ч 0 мин 0 с" 
											   FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" 
											   Foreground="#5B4F23" VerticalAlignment="Center" HorizontalAlignment="Left"/>

													<!-- Кнопка Копировать -->
													<Button Name="ConverterCopy" Grid.Column="1" Style="{StaticResource CopyButtonStyle}" 
											Width="32" Height="32" Margin="10,0,0,0"
											VerticalAlignment="Center" HorizontalAlignment="Right"
											Click="CopyFullResult_Click"/>
												</Grid>
											</Border>
										</StackPanel>
									</Grid>
								</Grid>
							</ScrollViewer>
						</Border>
					</Grid>
				</TabItem>


				<!-- Вкладка 4: Сумма/разность интервалов (Набор 4) -->
				<TabItem>
					<Grid Background="#E3DDD3">
						<!-- Карточка перекрашена в #F3B569 с отступами Margin="1" для стыковки краев -->
						<Border Background="#F3B569" CornerRadius="8" Padding="15" Margin="1">
							<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
								<Grid KeyboardNavigation.TabNavigation="Cycle">
							
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="0.22*"/>
										<ColumnDefinition Width="0.04*"/>
										<ColumnDefinition Width="0.22*"/>
										<ColumnDefinition Width="0.04*"/>
										<ColumnDefinition Width="0.22*"/>
										<ColumnDefinition Width="0.04*"/>
										<ColumnDefinition Width="0.22*"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<!-- Описание стилей кнопок под Набор 4 с инверсией цвета -->
									<Grid.Resources>
										<!-- 1. Основной стиль для простых кнопок -->
										<Style x:Key="IntervalButtonStyle" TargetType="Button">
											<Setter Property="FontSize" Value="14"/>
											<Setter Property="Cursor" Value="Hand"/>
											<Setter Property="IsTabStop" Value="False"/>
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="Button">
														<Border x:Name="ButtonBorder" 
															Background="#7A5123" 
															BorderBrush="#7A5123" 
															BorderThickness="1" 
															Padding="12,5" 
															CornerRadius="2">
															<ContentPresenter x:Name="ButtonContent" 
														                  HorizontalAlignment="Center" 
														                  VerticalAlignment="Center" 
														                  TextBlock.Foreground="#F3B569"/>
														</Border>
														<ControlTemplate.Triggers>
															<Trigger Property="IsMouseOver" Value="True">
																<Setter TargetName="ButtonBorder" Property="Border.Background" Value="#F3B569"/>
																<Setter TargetName="ButtonContent" Property="TextBlock.Foreground" Value="#7A5123"/>
																<Setter TargetName="ButtonBorder" Property="Border.BorderBrush" Value="#7A5123"/>
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>

										<!-- 2. Математический стиль для кнопок + и -, наследующий триггеры основного стиля -->
										<Style x:Key="MathButtonStyle" TargetType="Button" BasedOn="{StaticResource IntervalButtonStyle}">
											<Setter Property="IsTabStop" Value="True"/>
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="Button">
														
														<Border x:Name="ButtonBorder" 
															Background="#7A5123" 
															BorderBrush="#7A5123" 
															BorderThickness="1" 
															
															Height="45" 
															CornerRadius="2">
															<ContentPresenter x:Name="ButtonContent" 
														                  HorizontalAlignment="Center" 
														                  VerticalAlignment="Center" 
														                  TextBlock.Foreground="#F3B569" 
														                  TextBlock.FontSize="24" 
														                  TextBlock.FontWeight="SemiBold"/>
														</Border>
														<ControlTemplate.Triggers>
															
															<Trigger Property="IsMouseOver" Value="True">
																<Setter TargetName="ButtonBorder" Property="Border.Background" Value="#F3B569"/>
																<Setter TargetName="ButtonContent" Property="TextBlock.Foreground" Value="#7A5123"/>
																<Setter TargetName="ButtonBorder" Property="Border.BorderBrush" Value="#7A5123"/>
															</Trigger>
															<Trigger Property="IsFocused" Value="True">
																<Setter TargetName="ButtonBorder" Property="Border.Background" Value="#F3B569"/>
																<Setter TargetName="ButtonContent" Property="TextBlock.Foreground" Value="#7A5123"/>
																<Setter TargetName="ButtonBorder" Property="Border.BorderBrush" Value="#7A5123"/>
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>

										<!-- 3. Иконка копирования -->
										<Style x:Key="IconButtonStyle" TargetType="Button">
											<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
											<Setter Property="Content" Value="&#xE8C8;"/>
											<Setter Property="FontSize" Value="14"/>
											<Setter Property="Width" Value="36"/>
											<Setter Property="Height" Value="36"/>
											<Setter Property="Padding" Value="0"/>
											<Setter Property="IsTabStop" Value="False"/>
											<Setter Property="Cursor" Value="Hand"/>
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="Button">
														<Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="2">
															<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#7A5123"/>
														</Border>
														<ControlTemplate.Triggers>
															<Trigger Property="IsMouseOver" Value="True">
																<Setter TargetName="ButtonBorder" Property="Background" Value="#E3DDD3"/>
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</Grid.Resources>


									<!-- Заголовок -->
									<TextBlock Grid.Row="0" Grid.ColumnSpan="8" Text="Сумма/разность интервалов" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#7A5123"/>

									<!-- СТРОКА 1: ПОЛЯ ВВОДА -->
									<TextBox Grid.Row="1" Grid.Column="0" x:Name="InputIntervalDays" Text="д" FontSize="20" Height="45" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TabIndex="1" Background="#E3DDD3" BorderBrush="#4B5A65" Foreground="#7A5123" GotFocus="IntervalTextBox_GotFocus" LostFocus="IntervalTextBox_LostFocus" PreviewTextInput="InputValue_PreviewTextInput" PreviewKeyDown="InputValue_PreviewKeyDown"/>

									<TextBox Grid.Row="1" Grid.Column="2" x:Name="InputIntervalHours" Text="ч" FontSize="20" Height="45" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TabIndex="2" Background="#E3DDD3" BorderBrush="#4B5A65" Foreground="#7A5123" GotFocus="IntervalTextBox_GotFocus" LostFocus="IntervalTextBox_LostFocus" PreviewTextInput="InputValue_PreviewTextInput" PreviewKeyDown="InputValue_PreviewKeyDown"/>

									<TextBox Grid.Row="1" Grid.Column="4" x:Name="InputIntervalMinutes" Text="мин" FontSize="20" Height="45" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TabIndex="3" Background="#E3DDD3" BorderBrush="#4B5A65" Foreground="#7A5123" GotFocus="IntervalTextBox_GotFocus" LostFocus="IntervalTextBox_LostFocus" PreviewTextInput="InputValue_PreviewTextInput" PreviewKeyDown="InputValue_PreviewKeyDown"/>

									<TextBox Grid.Row="1" Grid.Column="6" x:Name="InputIntervalSeconds" Text="с" FontSize="20" Height="45" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TabIndex="4" Background="#E3DDD3" BorderBrush="#4B5A65" Foreground="#7A5123" GotFocus="IntervalTextBox_GotFocus" LostFocus="IntervalTextBox_LostFocus" PreviewTextInput="InputValue_PreviewTextInput" PreviewKeyDown="InputValue_PreviewKeyDown"/>

								
									<!-- СТРОКА 2: Кнопки -->
									<Button Grid.Row="2" Grid.Column="0" Margin="0,25,0,0" Content="+" Style="{StaticResource MathButtonStyle}" Click="AddInterval_Click" TabIndex="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

									<Button Grid.Row="2" Grid.Column="2" Margin="0,25,0,0" Content="-" Style="{StaticResource MathButtonStyle}" Click="SubtractInterval_Click" TabIndex="6"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

									<Button Grid.Row="2" Grid.Column="6" Margin="0,25,0,0" Content="Очистить" Style="{StaticResource IntervalButtonStyle}" Click="ClearResult_Click" Height="45" Padding="15,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
									
									<!-- СТРОКА 3: БЛОК ВЫВОДА РЕЗУЛЬТАТА -->
									<Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="8" x:Name="IntervalResultBorder" 
							Background="Transparent" BorderBrush="#7A5123" BorderThickness="1" CornerRadius="2" 
							Height="70" Margin="0,25,0,0" HorizontalAlignment="Stretch">
										<Grid Margin="10,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<TextBlock x:Name="IntervalResult" Grid.Column="0" Text="0 д 0 ч 0 мин 0 с" FontSize="20" FontWeight="SemiBold" Foreground="#7A5123" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap"/>
											<Button Name="IntervalCopy" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="CopyFullResult_Click" ToolTip="Copy" VerticalAlignment="Center"/>
										</Grid>
									</Border>
								</Grid>
							</ScrollViewer>
						</Border>
					</Grid>
				</TabItem>

				<!-- Вкладка 5: Пустая  -->
				<TabItem>
					<Grid Background="#F3EFE9">
						<!-- Коралловая карточка -->
						<Border Background="#EE6E65" CornerRadius="8" Padding="15" Margin="5">
							<Grid>
								<!-- Текст тёмно-бордовый -->
								<TextBlock Text="Вкладка 5 (Пусто)" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="16" 
                           Foreground="#4B1D1A" 
                           FontWeight="SemiBold"/>
							</Grid>
						</Border>
					</Grid>
				</TabItem>


			</TabControl>
		</Grid>
	</Grid>
</Window>
